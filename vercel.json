{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "site",
  "trailingSlash": false,
  "functions": {
    "api/mcp.mjs": { "includeFiles": "{dist/icons.json,package.json}", "maxDuration": 10 }
  },
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/:path*", "permanent": true },
    {
      "source": "/:path((?!mcp$|api/|robots\\.txt$|sitemap\\.xml$|icons$|guide$|showcase$|license$|es$|es/(?:icons|guide|showcase|license)$|_astro/|imgs/|relay-fv/|favicon-light\\.svg$|favicon-dark\\.svg$|favicon\\.ico$|apple-touch-icon\\.png$|android-touch-icon\\.png$|android-touch-icon-512\\.png$|manifest\\.json$).+)",
      "destination": "https://flouvia.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/", "destination": "https://flouvia.com/en/gota" },
    { "source": "/:page(icons|guide|showcase|license)", "destination": "https://flouvia.com/en/gota/:page" },
    { "source": "/es", "destination": "https://flouvia.com/gota" },
    { "source": "/es/:page(icons|guide|showcase|license)", "destination": "https://flouvia.com/gota/:page" },
    { "source": "/:dir(_astro|imgs|relay-fv)/:path*", "destination": "https://flouvia.com/:dir/:path*" },
    { "source": "/:file(favicon-light\\.svg|favicon-dark\\.svg|favicon\\.ico|apple-touch-icon\\.png|android-touch-icon\\.png|android-touch-icon-512\\.png|manifest\\.json)", "destination": "https://flouvia.com/:file" }
  ]
}
