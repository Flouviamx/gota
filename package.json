{
  "name": "@flouvia/gota",
  "version": "0.1.0",
  "description": "Gota, Flouvia's icon library: continuous corners, a single 1.5 stroke and the drop as a signature.",
  "license": "MIT",
  "author": "Flouvia, S.A.S. de C.V. (https://flouvia.com)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/_icon.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react/icons": {
      "types": "./dist/react-icons.d.ts",
      "default": "./dist/react-icons.js"
    },
    "./vue": "./dist/vue.js",
    "./vue/icons": "./dist/vue-icons.js",
    "./svelte": {
      "svelte": "./dist/Icon.svelte",
      "default": "./dist/Icon.svelte"
    },
    "./svelte/base": {
      "svelte": "./dist/IconBase.svelte",
      "default": "./dist/IconBase.svelte"
    },
    "./astro": "./dist/Icon.astro",
    "./morph": {
      "types": "./dist/morph.d.ts",
      "default": "./dist/morph.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./sprite.svg": "./dist/sprite.svg",
    "./sprite-fill.svg": "./dist/sprite-fill.svg",
    "./svg/*": "./svg/*",
    "./icons.json": "./dist/icons.json",
    "./icons.css": "./dist/icons.css",
    "./motion.css": "./dist/motion.css",
    "./font.css": "./dist/fonts/gota.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist",
    "!dist/fonts/*.ttf",
    "!dist/xcode",
    "!dist/android",
    "!dist/figma",
    "svg",
    "mcp",
    "migrate",
    "LICENSE",
    "README.md",
    "README.es.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sheet": "node scripts/sheet.mjs",
    "test": "node --test 'tests/*.test.mjs'",
    "qa": "node scripts/qa.mjs",
    "sheets": "node scripts/sheets.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gota-mcp": "./mcp/server.mjs",
    "gota-migrate": "./migrate/cli.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "canvaskit-wasm": "^0.41.1"
  }
}
