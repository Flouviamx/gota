{
  "name": "@flouvia/gota",
  "version": "0.1.0",
  "description": "Gota, Flouvia's icon library: continuous corners, a single 1.5 stroke and the drop as a signature.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svg/*": "./svg/*",
    "./icons.json": "./dist/icons.json",
    "./icons.css": "./dist/icons.css",
    "./motion.css": "./dist/motion.css",
    "./vue": "./dist/vue.js",
    "./svelte": "./dist/Icon.svelte",
    "./astro": "./dist/Icon.astro",
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./morph": {
      "types": "./dist/morph.d.ts",
      "default": "./dist/morph.js"
    }
  },
  "files": [
    "dist",
    "svg",
    "mcp",
    "LICENSE",
    "README.md",
    "README.es.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.5",
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sheet": "node scripts/sheet.mjs",
    "test": "node --test 'tests/*.test.mjs'",
    "qa": "node scripts/qa.mjs",
    "sheets": "node scripts/sheets.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gota-mcp": "./mcp/server.mjs"
  }
}
