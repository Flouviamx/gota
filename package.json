{
  "name": "@flouvia/gota",
  "version": "0.1.0",
  "description": "Gota, los íconos de Flouvia: esquinas continuas, un trazo de 1.5 y la gota del isotipo como firma.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svg/*": "./svg/*",
    "./icons.json": "./dist/icons.json",
    "./icons.css": "./dist/icons.css"
  },
  "files": [
    "dist",
    "svg",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sheet": "node scripts/sheet.mjs",
    "test": "node --test 'tests/*.test.mjs'",
    "qa": "node scripts/qa.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
